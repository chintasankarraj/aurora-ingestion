# ==============================================================================
# Aurora Ingestion Pipeline Environment Configuration
# ==============================================================================

# Required: Path to the root directory of your Aurora Obsidian vault
# Example: C:/Users/username/Documents/ObsidianVault or /home/user/vault
AURORA_VAULT_PATH=

# Optional: Path to SQLite deduplication tracking database
# Defaults to "aurora_ingestion_tracker.sqlite" in the service root if unset
AURORA_TRACKER_DB_PATH=aurora_ingestion_tracker.sqlite

# Logging configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==============================================================================
# Email Connector Credentials (Gmail & Outlook)
# ==============================================================================

# Gmail / Google API (OAuth 2.0 Desktop app credentials)
# GMAIL_CREDENTIALS_PATH=.credentials/gmail_credentials.json
# GMAIL_TOKEN_PATH=.credentials/gmail_token.json

# Microsoft Outlook / Microsoft Graph API (Delegated User Access)
# Option 1: Direct Delegated Access Token (pre-acquired via Azure CLI / Graph Explorer)
# OUTLOOK_ACCESS_TOKEN=

# Option 2: Delegated Device Code Flow (interactive browser sign-in via MSAL)
# Note: OUTLOOK_CLIENT_SECRET is NOT needed for delegated public CLI client.
# OUTLOOK_CLIENT_ID=
# OUTLOOK_TENANT_ID=common
# OUTLOOK_TOKEN_CACHE_PATH=.credentials/outlook_token_cache.bin

# ==============================================================================
# Future Source Connector Credentials
# ==============================================================================

# Notion
# NOTION_API_KEY=

# GitHub
# GITHUB_TOKEN=

# Slack
# SLACK_BOT_TOKEN=
